# HOKM environment — copy to .env and fill in for your deployment. Never commit real values.

# Core environment
HOKM_ENVIRONMENT=dev
HOKM_DATABASE_URL=sqlite+aiosqlite:///./hokm.db
HOKM_REDIS_URL=redis://localhost:6379/0
HOKM_USE_REDIS=false

# Telegram Mini App (must match your bot). Keep the token server-side only.
HOKM_TELEGRAM_BOT_TOKEN=

# Sessions / tokens
HOKM_JWT_SECRET=replace-with-a-long-random-secret
HOKM_ACCESS_TOKEN_TTL_SECONDS=900
HOKM_REFRESH_TOKEN_TTL_SECONDS=2592000

# Game rules + reliability
HOKM_RULES_VERSION=hokm-v1
HOKM_TURN_TIMEOUT_SECONDS=30
HOKM_RECONNECT_GRACE_SECONDS=60
HOKM_BOT_FALLBACK_AFTER_SECONDS=60

# Matchmaking
HOKM_MM_INITIAL_RATING_RANGE=100
HOKM_MM_MAX_RATING_RANGE=800
HOKM_MM_RANGE_EXPAND_SECONDS=15
HOKM_MM_BOT_FALLBACK_SECONDS=45
HOKM_MM_BOT_FALLBACK_ENABLED=true

HOKM_TELEGRAM_BOT_USERNAME=
HOKM_TELEGRAM_MINI_APP_SHORT_NAME=

# Shared secret used only by the trusted Telegram Stars fulfillment webhook
HOKM_TELEGRAM_PAYMENT_WEBHOOK_SECRET=
